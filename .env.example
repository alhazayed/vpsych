# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Prefer REPORT_WRITE_KEY + create_session_report RPC.
# Service role bypasses RLS — restrict to session report privileged writes.
# SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for signed report RPC (required if service role is unset)
# REPORT_WRITE_KEY=

# AI — Vercel AI Gateway (preferred when set) or official OpenAI SDK
AI_GATEWAY_API_KEY=
# Optional gateway model id (AI Gateway format)
AI_MODEL=openai/gpt-4o-mini

# Official OpenAI SDK (GPT-5 chat + primary Speech-to-Text)
OPENAI_API_KEY=
# GPT-5 chat model (default gpt-5)
OPENAI_CHAT_MODEL=gpt-5
# Speech-to-text model (default gpt-4o-transcribe; whisper-1 also supported)
OPENAI_STT_MODEL=gpt-4o-transcribe
# Optional: force chat provider — openai | gateway (auto when unset)
# OPENAI_CHAT_PROVIDER=openai
# Optional OpenAI model used after primary chat hits 429/quota (not an HTTP retry):
# OPENAI_FALLBACK_CHAT_MODEL=gpt-4o-mini
# OPENAI_MAX_RETRIES=3
# OPENAI_TIMEOUT_MS=60000

# Voice — ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional overrides for default voices (also stored per-avatar in Supabase)
ELEVENLABS_VOICE_ID_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_AR=pNInz6obpgDQGcFmaJgB
# In-memory TTS cache (repeated preview / short turns)
# ELEVENLABS_CACHE_TTL_MS=600000
# ELEVENLABS_CACHE_MAX_ENTRIES=64
# Upstream TTS hard timeout in ms (Stage 12; default 30000)
# ELEVENLABS_TIMEOUT_MS=30000

# Voice — Azure AI Speech (legacy STT; no longer used by the voice session pipeline)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# Optional legacy STT fallback (unused by current OpenAI STT pipeline)
# DEEPGRAM_API_KEY=

# Distributed rate limiting (optional — falls back to in-memory when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Expert evaluation portal (/validation) — comma-separated invitation codes.
# Required in production; local/dev falls back to RC1-PREVIEW when unset.
# VALIDATION_INVITE_CODES=RC1-PREVIEW,INSTITUTION-ALPHA

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Therapy Room Mode (Mission 34) — optional immersive consultation room.
# When true, Start Session offers Classic vs Therapy Room. Default remains Classic.
# NEXT_PUBLIC_THERAPY_ROOM_MODE=true
# Hands-free turn-taking (Therapy Room) — clinical wait bias (ms).
# Stage-1 silence → endpoint candidate; Stage-2 additional silence → commit turn.
# VOICE_TURN_ENDPOINT_INITIAL_MS=1000
# VOICE_TURN_ENDPOINT_CONFIRM_MS=500
# VOICE_TURN_MAX_WAIT_MS=2200
# VOICE_TURN_MIN_SPEECH_MS=400
# VOICE_TURN_BARGE_IN_MIN_MS=280
# Mission 10 — Humanization Engine (default ON when clinical_snapshot present).
# HUMANIZATION_ENABLED=false
# Therapy sessions expire after MAX_SESSION_SECONDS (40 minutes) server-side.
# Auth JWT / idle session lifetime is configured in the Supabase Auth dashboard
# (Authentication → Settings → JWT expiry). Default project setting: 3600s.

# Virtual Mental Health Center / Therapy Room (Mission 35)
# When true, enables /clinic dashboard, consultation room, private notes,
# supervisor office, and end-of-day summary. Legacy /sessions chat UI remains.
# Set NEXT_PUBLIC_FEATURE_THERAPY_ROOM for any client-only gates (optional).
# FEATURE_THERAPY_ROOM=true
# NEXT_PUBLIC_FEATURE_THERAPY_ROOM=true

# Stage 11 — Real-Time Clinical Simulation (voice gateway / streaming / avatar)
# Classic VoiceSession remains default. Opt-in for enhanced realtime chrome + SSE.
# FEATURE_REALTIME_SIMULATION=true
# NEXT_PUBLIC_FEATURE_REALTIME_SIMULATION=true
# Optional explicit streaming toggle (defaults on when simulation is enabled):
# FEATURE_REALTIME_STREAMING=true
# NEXT_PUBLIC_FEATURE_REALTIME_STREAMING=true

# Conversation Behaviour Engine (Mission 7) — advanced patient behaviours
# (avoidance, silence, rapport-gated disclosure, …). Default: on.
# CBE_ENABLED=false
