# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — preferred for privileged writes (reports). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key matching vault secret `report_write_key` (required if service role is unset).
# Create/read via: select decrypted_secret from vault.decrypted_secrets where name = 'report_write_key';
REPORT_WRITE_KEY=

# AI — Vercel AI Gateway (preferred) or OpenAI-compatible key
AI_GATEWAY_API_KEY=
# Optional fallback model id (AI Gateway format)
AI_MODEL=openai/gpt-4o-mini

# Optional server STT
DEEPGRAM_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
