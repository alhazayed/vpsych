# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI — Vercel AI Gateway (preferred) or OpenAI-compatible key
AI_GATEWAY_API_KEY=
# Optional fallback model id (AI Gateway format)
AI_MODEL=openai/gpt-4o-mini

# Voice — Azure AI Speech (STT)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Voice — ElevenLabs (TTS)
ELEVENLABS_API_KEY=
# Optional overrides for default voices (also stored per-avatar in Supabase)
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_AR=XB0fDUnXU5powFXDhCwa

# Optional legacy STT fallback
# DEEPGRAM_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
